---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import { swimSpas } from '../../data/swim-spas';

const totalModels = swimSpas.reduce((sum, s) => {
  const flat = s.models?.length ?? 0;
  const nested = s.subSeries?.reduce((n, sub) => n + sub.models.length, 0) ?? 0;
  return sum + flat + nested;
}, 0);
const siteOrigin = Astro.site?.origin ?? 'https://hottubuniverse.ca';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteOrigin}/` },
    { '@type': 'ListItem', position: 2, name: 'Swim Spas', item: `${siteOrigin}/swim-spas/` },
  ],
};

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Swim Spas at Hot Tub Universe — Halifax / Bedford',
  url: `${siteOrigin}/swim-spas/`,
  hasPart: swimSpas.map((s) => ({
    '@type': 'Product',
    name: `${s.brand} ${s.name}`,
    description: s.tagline,
    brand: { '@type': 'Brand', name: s.brand },
    url: `${siteOrigin}/swim-spas/${s.slug}/`,
    image: `${siteOrigin}${s.cardImage}`,
  })),
};
---
<BaseLayout
  title="Swim Spas in Halifax & Bedford NS | Michael Phelps & H2X | Hot Tub Universe"
  description="Master Spas swim spas at Hot Tub Universe in Bedford — Michael Phelps Signature and H2X. Swim, train, and recover year-round. Delivery and service across HRM."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
  </Fragment>

  <Header />

  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="container">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page">Swim Spas</li>
      </ol>
    </div>
  </nav>

  <!-- Hub hero -->
  <section class="hub-hero">
    <div class="container">
      <div class="hub-hero-inner">
        <div class="section-eyebrow">Swim Spas</div>
        <h1>Swim, train, and unwind — all year.</h1>
        <p class="hub-hero-sub">
          Two Master Spas swim spa lines: the Michael Phelps Signature and the H2X. A pool, a hot tub, and a fitness tool in one footprint —
          sized to fit HRM backyards where a traditional pool can't.
        </p>
        <div class="hero-ctas" style="justify-content: center;">
          <a href="/contact/" class="btn btn-primary">
            Request a Quote
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/#visit" class="btn btn-outline">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Visit Bedford Showroom
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- The 2 series -->
  <section class="block">
    <div class="container">
      <div class="section-head">
        <div class="section-eyebrow">Both lines we carry</div>
        <h2>Which swim spa fits you?</h2>
        <p>Both built by Master Spas. Both built for year-round serious swimming. Visit a series page or come compare in person.</p>
      </div>
      <div class="product-grid cols-2" style="max-width: 880px; margin: 0 auto;">
        {swimSpas.map((s) => (
          <ProductCard
            brand={s.brand}
            name={s.name}
            description={s.tagline}
            image={s.cardImage}
            imageAlt={`${s.brand} ${s.name} swim spa`}
            href={`/swim-spas/${s.slug}/`}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- What is a swim spa -->
  <section class="block alt">
    <div class="container">
      <div class="section-head">
        <div class="section-eyebrow">If you're new to swim spas</div>
        <h2>What exactly is a swim spa?</h2>
        <p>A hybrid product that doesn't get the attention it deserves — especially in Atlantic Canada.</p>
      </div>
      <div class="chooser-grid">
        <div class="chooser-card">
          <div class="chooser-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/><path d="M3 18c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/><path d="M3 6c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/></svg>
          </div>
          <h3>Half pool, half hot tub</h3>
          <p>A swim spa is a compact rectangular spa with a powerful jet creating a current you swim against in place. You get the swim, the soak, and the recovery in one footprint.</p>
        </div>
        <div class="chooser-card">
          <div class="chooser-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="12 6 12 12 16 14"/><circle cx="12" cy="12" r="10"/></svg>
          </div>
          <h3>Works year-round</h3>
          <p>Unlike a pool, you don't close it in October. Heated and insulated for cold Atlantic winters — many of our customers swim more in February than in July.</p>
        </div>
        <div class="chooser-card">
          <div class="chooser-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
          </div>
          <h3>Fits where a pool can't</h3>
          <p>Typically 15-19 feet long and 7-8 feet wide. Much smaller backyard footprint than a pool, with no fence/setback regulations to navigate in HRM.</p>
        </div>
        <div class="chooser-card">
          <div class="chooser-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v6m0 10v6M4.22 4.22l4.24 4.24m7.08 7.08l4.24 4.24M1 12h6m10 0h6M4.22 19.78l4.24-4.24m7.08-7.08l4.24-4.24"/></svg>
          </div>
          <h3>Adjustable swim current</h3>
          <p>Beginner-friendly to competitive-level intensity, dialed in by you. Triathletes, marathon swimmers, and casual users all set their own pace.</p>
        </div>
        <div class="chooser-card">
          <div class="chooser-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
          <h3>Therapy seats included</h3>
          <p>Most swim spas come with dedicated hydrotherapy seats next to the swim lane. Recover after a workout, or use the spa half independently as a hot tub.</p>
        </div>
        <div class="chooser-card">
          <div class="chooser-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>
          </div>
          <h3>Still unsure?</h3>
          <p>The best way to understand a swim spa is to stand in one with the current running. <a href="/#visit">Visit the showroom</a> or <a href="/contact/">request a quote</a> and we'll set up a demo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Showroom CTA -->
  <section class="visit-section">
    <div class="container">
      <div class="visit-grid">
        <div class="visit-content">
          <div class="section-eyebrow">Plan Your Visit</div>
          <h2>Try one in real water.</h2>
          <p>Drop by the Bedford showroom — you can feel the swim current and try the therapy seats before you commit.</p>
          <div class="hero-ctas" style="margin-bottom: 0;">
            <a href="https://maps.google.com/?q=20+Duke+Street+Unit+109+Bedford+NS" class="btn btn-primary" rel="noopener">
              Get Directions
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/contact/" class="btn btn-outline">Request a Quote</a>
          </div>
        </div>
        <div class="visit-address">
          <div class="visit-address-line">
            <div class="visit-address-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></div>
            <div>
              <div class="visit-address-label">Showroom</div>
              <div class="visit-address-value">20 Duke Street, Unit 109<br />Bedford, NS B4A 2Z5</div>
            </div>
          </div>
          <div class="visit-address-line">
            <div class="visit-address-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></div>
            <div>
              <div class="visit-address-label">Phone</div>
              <div class="visit-address-value">902-576-5115</div>
            </div>
          </div>
          <div class="visit-address-line">
            <div class="visit-address-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
            <div>
              <div class="visit-address-label">Hours</div>
              <div class="visit-address-value">Mon–Fri · 10am–5pm<br />Sat · 10am–4pm<br />Sun · Closed</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
