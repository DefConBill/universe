---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { swimSpas as allSwimSpas, type Series, type Model } from '../../../data/swim-spas';

export async function getStaticPaths() {
  const paths = [];
  for (const s of allSwimSpas) {
    if (s.models) {
      for (const m of s.models) {
        paths.push({
          params: { swimspa: s.slug, model: m.slug },
          props: { seriesData: s, modelData: m, subSeriesName: null as string | null },
        });
      }
    }
    if (s.subSeries) {
      for (const sub of s.subSeries) {
        for (const m of sub.models) {
          paths.push({
            params: { swimspa: s.slug, model: m.slug },
            props: { seriesData: s, modelData: m, subSeriesName: sub.name },
          });
        }
      }
    }
  }
  return paths;
}

interface Props {
  seriesData: Series;
  modelData: Model;
  subSeriesName: string | null;
}

const { seriesData, modelData, subSeriesName } = Astro.props;
const siteOrigin = Astro.site?.origin ?? 'https://hottubuniverse.ca';
const heroImage = modelData.image ?? seriesData.hero;

// Find other models in the same series for cross-sell
const otherModels: Model[] = [];
if (seriesData.models) otherModels.push(...seriesData.models.filter((m) => m.slug !== modelData.slug));
if (seriesData.subSeries) {
  for (const sub of seriesData.subSeries) {
    otherModels.push(...sub.models.filter((m) => m.slug !== modelData.slug));
  }
}

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteOrigin}/` },
    { '@type': 'ListItem', position: 2, name: 'Swim Spas', item: `${siteOrigin}/swim-spas/` },
    { '@type': 'ListItem', position: 3, name: seriesData.name, item: `${siteOrigin}/swim-spas/${seriesData.slug}/` },
    { '@type': 'ListItem', position: 4, name: modelData.name, item: `${siteOrigin}/swim-spas/${seriesData.slug}/${modelData.slug}/` },
  ],
};

const productJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${seriesData.brand} ${modelData.name}`,
  description: modelData.longDescription ?? modelData.description ?? `${seriesData.brand} ${modelData.name} swim spa`,
  brand: { '@type': 'Brand', name: seriesData.brand },
  image: `${siteOrigin}${heroImage}`,
  category: 'Swim Spas',
  url: `${siteOrigin}/swim-spas/${seriesData.slug}/${modelData.slug}/`,
};

const specRows: Array<{ label: string; value: string }> = [];
if (modelData.seating) specRows.push({ label: 'Seating Capacity', value: modelData.seating });
if (modelData.dimensions) {
  const dim = modelData.dimensionsMetric ? `${modelData.dimensions} (${modelData.dimensionsMetric})` : modelData.dimensions;
  specRows.push({ label: 'Dimensions', value: dim });
}
if (modelData.weightDry || modelData.weightFull) {
  const wt = [modelData.weightDry, modelData.weightFull].filter(Boolean).join(' / ');
  specRows.push({ label: 'Weight (Dry / Full)', value: wt });
}
if (modelData.gallons) specRows.push({ label: 'Water Capacity', value: modelData.gallons });
if (modelData.power) specRows.push({ label: 'Power Requirement', value: modelData.power });
if (modelData.jets) specRows.push({ label: 'Jets', value: modelData.jets });
if (modelData.pumps) specRows.push({ label: 'Pumps', value: modelData.pumps });
if (modelData.propulsion) specRows.push({ label: 'Propulsion System', value: modelData.propulsion });
if (modelData.waterFeatures) specRows.push({ label: 'Water Features', value: modelData.waterFeatures });
if (modelData.waterCare) specRows.push({ label: 'Water Care', value: modelData.waterCare });
if (modelData.lighting) specRows.push({ label: 'LED Lighting', value: modelData.lighting });

const pageTitle = `${seriesData.brand} ${modelData.name} | ${seriesData.name} | Hot Tub Universe — Bedford NS`;
const pageDescription = modelData.longDescription
  ? modelData.longDescription.replace(/\s+/g, ' ').slice(0, 155).trim() + (modelData.longDescription.length > 155 ? '…' : '')
  : `${seriesData.brand} ${modelData.name} swim spa at Hot Tub Universe in Bedford. Delivery and service across Halifax & HRM.`;
---
<BaseLayout title={pageTitle} description={pageDescription} ogImage={heroImage}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
  </Fragment>

  <Header />

  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="container">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-hidden="true">›</li>
        <li><a href="/swim-spas/">Swim Spas</a></li>
        <li aria-hidden="true">›</li>
        <li><a href={`/swim-spas/${seriesData.slug}/`}>{seriesData.name}</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page">{modelData.name}</li>
      </ol>
    </div>
  </nav>

  <!-- Model hero -->
  <section class="model-hero">
    <div class="container">
      <div class="model-hero-inner">
        <div class="model-hero-image">
          <img src={heroImage} alt={`${seriesData.brand} ${modelData.name} swim spa`} />
        </div>
        <div class="model-hero-content">
          <div class="model-hero-brand">
            {seriesData.brand} · <a href={`/swim-spas/${seriesData.slug}/`}>{seriesData.name}</a>
            {subSeriesName && <span class="model-hero-subseries"> · {subSeriesName}</span>}
          </div>
          <h1>{modelData.name}</h1>
          {modelData.longDescription && <p class="model-hero-desc">{modelData.longDescription}</p>}

          {(modelData.seating || modelData.jets || modelData.pumps) && (
            <div class="model-hero-stats">
              {modelData.seating && (
                <div class="model-stat">
                  <div class="model-stat-value">{modelData.seatingCapacity ?? modelData.seating}</div>
                  <div class="model-stat-label">Seats</div>
                </div>
              )}
              {modelData.jets && (
                <div class="model-stat">
                  <div class="model-stat-value">{modelData.jets.match(/\d+/)?.[0] ?? modelData.jets}</div>
                  <div class="model-stat-label">Jets</div>
                </div>
              )}
              {modelData.pumps && (
                <div class="model-stat">
                  <div class="model-stat-value">{modelData.pumps}</div>
                  <div class="model-stat-label">Pumps</div>
                </div>
              )}
            </div>
          )}

          <div class="hero-ctas" style="margin-top: 32px;">
            <a href="/contact/" class="btn btn-primary">
              Request a Quote
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/#visit" class="btn btn-outline">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Visit Showroom
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Specs + Features -->
  {(specRows.length > 0 || (modelData.features && modelData.features.length > 0)) && (
    <section class="block alt">
      <div class="container">
        <div class="specs-grid">
          {specRows.length > 0 && (
            <div class="specs-block">
              <div class="section-eyebrow">Specifications</div>
              <h2>By the numbers.</h2>
              <table class="specs-table">
                <tbody>
                  {specRows.map((row) => (
                    <tr>
                      <th scope="row">{row.label}</th>
                      <td>{row.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
          {modelData.features && modelData.features.length > 0 && (
            <div class="features-block">
              <div class="section-eyebrow">Exclusive Features</div>
              <h2>What sets the {modelData.name} apart.</h2>
              <ul class="features-list">
                {modelData.features.map((f) => (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Photo gallery -->
  {modelData.gallery && modelData.gallery.length > 0 && (
    <section class="block cream">
      <div class="container">
        <div class="section-head">
          <div class="section-eyebrow">Gallery</div>
          <h2>A closer look at the {modelData.name}.</h2>
        </div>
        <div class={`model-gallery count-${modelData.gallery.length}`}>
          {modelData.gallery.map((src, i) => (
            <button class="model-gallery-item" type="button" data-full={src} aria-label={`Enlarge photo ${i + 1} of the ${modelData.name}`}>
              <img src={src} alt={`${seriesData.brand} ${modelData.name} swim spa — photo ${i + 1}`} loading="lazy" />
            </button>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Down shot -->
  {modelData.downShot && (
    <section class="block white">
      <div class="container">
        <h2 class="downshot-heading">{modelData.name}</h2>
        <div class="downshot">
          <img src={modelData.downShot} alt={`Top-down view of the ${seriesData.brand} ${modelData.name} swim spa showing interior layout`} loading="lazy" />
        </div>
      </div>
    </section>
  )}

  <!-- Quote CTA -->
  <section class="block">
    <div class="container">
      <div class="quote-callout">
        <div>
          <div class="section-eyebrow" style="color: var(--sky);">Next step</div>
          <h2>Get a quote on the {modelData.name}.</h2>
          <p>Tell us about your space and we'll send back precise pricing — delivery, install, electrical, crane (if needed), and accessories included.</p>
        </div>
        <div class="quote-callout-actions">
          <a href="/contact/" class="btn btn-primary">Request a Quote</a>
          <a href="tel:9025765115" class="btn btn-outline">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            902-576-5115
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Other models in same swim spa series -->
  {otherModels.length > 0 && (
    <section class="block alt">
      <div class="container">
        <div class="section-head">
          <div class="section-eyebrow">More in {seriesData.name}</div>
          <h2>Other {seriesData.shortName} models.</h2>
        </div>
        <div class="other-models-grid">
          {otherModels.map((m) => (
            <a href={`/swim-spas/${seriesData.slug}/${m.slug}/`} class="other-model-link">
              <span class="other-model-name">{m.name}</span>
              {m.seating && <span class="other-model-meta">{m.seating}</span>}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Feature sheet PDF embed -->
  {modelData.pdfUrl && (
    <section class="block">
      <div class="container">
        <div class="section-head">
          <div class="section-eyebrow">Full Feature Sheet</div>
          <h2>The official {modelData.name} brochure.</h2>
          <p>Manufacturer specs, dimensions, and feature details. Open in a new tab if it doesn't load inline.</p>
        </div>
        <div class="pdf-embed">
          <iframe
            src={modelData.pdfUrl}
            title={`${seriesData.brand} ${modelData.name} feature sheet`}
            loading="lazy"
          ></iframe>
        </div>
        <div class="pdf-fallback">
          <a href={modelData.pdfUrl} target="_blank" rel="noopener" class="btn btn-outline">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            Open PDF in new tab
          </a>
        </div>
      </div>
    </section>
  )}

  {modelData.gallery && modelData.gallery.length > 0 && (
    <div class="lightbox" id="lightbox" hidden>
      <button class="lightbox-close" type="button" aria-label="Close gallery">&times;</button>
      <img class="lightbox-img" src="" alt="" />
    </div>
  )}

  <Footer />

  <script>
    (function () {
      const lb = document.getElementById('lightbox');
      if (!lb) return;
      const img = lb.querySelector('.lightbox-img');
      const closeBtn = lb.querySelector('.lightbox-close');
      const openLb = (src, alt) => {
        img.src = src; img.alt = alt || '';
        lb.hidden = false;
        document.body.style.overflow = 'hidden';
      };
      const closeLb = () => {
        lb.hidden = true; img.src = '';
        document.body.style.overflow = '';
      };
      document.querySelectorAll('.model-gallery-item').forEach((btn) => {
        btn.addEventListener('click', () => {
          const thumb = btn.querySelector('img');
          openLb(btn.getAttribute('data-full'), thumb ? thumb.alt : '');
        });
      });
      lb.addEventListener('click', (e) => { if (e.target === lb) closeLb(); });
      closeBtn.addEventListener('click', closeLb);
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !lb.hidden) closeLb(); });
    })();
  </script>
</BaseLayout>
