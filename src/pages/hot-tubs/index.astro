---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import { series } from '../../data/series';

const totalModels = series.reduce((sum, s) => {
  const flat = s.models?.length ?? 0;
  const nested = s.subSeries?.reduce((n, sub) => n + sub.models.length, 0) ?? 0;
  return sum + flat + nested;
}, 0);
const siteOrigin = Astro.site?.origin ?? 'https://hottubuniverse.ca';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteOrigin}/` },
    { '@type': 'ListItem', position: 2, name: 'Hot Tubs', item: `${siteOrigin}/hot-tubs/` },
  ],
};

// CollectionPage / ItemList schema — helps the hub page surface in "hot tubs near me" rich results
const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Hot Tubs at Hot Tub Universe — Halifax / Bedford',
  url: `${siteOrigin}/hot-tubs/`,
  hasPart: series.map((s) => ({
    '@type': 'Product',
    name: `${s.brand} ${s.name}`,
    description: s.tagline,
    brand: { '@type': 'Brand', name: s.brand },
    url: `${siteOrigin}/hot-tubs/${s.slug}/`,
    image: `${siteOrigin}${s.cardImage}`,
  })),
};
---
<BaseLayout
  title="Hot Tubs in Halifax & Bedford NS | Master Spas, Clarity, Getaway | Hot Tub Universe"
  description="Five series, 29 models — from plug-and-play Getaway to the Michael Phelps Legend. Halifax's locally owned full-service hot tub dealer. Visit the Bedford showroom or browse the lineup."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
  </Fragment>

  <Header />

  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="container">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page">Hot Tubs</li>
      </ol>
    </div>
  </nav>

  <!-- Hub hero -->
  <section class="hub-hero">
    <div class="container">
      <div class="hub-hero-inner">
        <div class="section-eyebrow">Hot Tubs</div>
        <h1>Browse the entire lineup.</h1>
        <p class="hub-hero-sub">
          {series.length} series. {totalModels} models. From plug-and-play Getaway to the Michael Phelps Legend.
          Sold, delivered, and serviced from our Bedford showroom across HRM.
        </p>
        <div class="hero-ctas" style="justify-content: center;">
          <a href="/contact/" class="btn btn-primary">
            Request a Quote
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/#visit" class="btn btn-outline">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Visit Bedford Showroom
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- All 5 series -->
  <section class="block">
    <div class="container">
      <div class="section-head">
        <div class="section-eyebrow">All Five Series</div>
        <h2>Pick a series to dig in.</h2>
        <p>Each series has its own page with the full model list, photos, FAQ, and a path to a quote.</p>
      </div>
      <div class="product-grid">
        {series.map((s) => (
          <ProductCard
            brand={s.brand}
            name={s.name}
            description={s.tagline}
            image={s.cardImage}
            imageAlt={`${s.brand} ${s.name} hot tub`}
            href={`/hot-tubs/${s.slug}/`}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Help me choose -->
  <section class="block alt">
    <div class="container">
      <div class="section-head">
        <div class="section-eyebrow">Not Sure Where to Start</div>
        <h2>Which series fits you?</h2>
        <p>A quick orientation. The best way to decide is still to come sit in one — but here's the gist.</p>
      </div>
      <div class="chooser-grid">
        <a href="/hot-tubs/getaway-hot-tubs/" class="chooser-card">
          <div class="chooser-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
          </div>
          <h3>First-time owner or smaller backyard</h3>
          <p>Start with <strong>Getaway</strong> — plug-and-play friendly, the most accessible price point, and a five-model lineup that fits most spaces.</p>
          <span class="chooser-cta">Explore Getaway <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/hot-tubs/legend-series/" class="chooser-card">
          <div class="chooser-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <h3>Recovery, therapy, or athletic use</h3>
          <p>The <strong>Legend Series</strong> was designed with Michael Phelps and is built around serious hydrotherapy. The right pick if you want the most powerful jets we sell.</p>
          <span class="chooser-cta">Explore Legend <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/hot-tubs/twilight-series/" class="chooser-card">
          <div class="chooser-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <h3>Everyday luxury, refined design</h3>
          <p>The <strong>Twilight Series</strong> brings premium Master Spas build quality and a quietly powerful soak — tuned for daily relaxation rather than aggressive therapy.</p>
          <span class="chooser-cta">Explore Twilight <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/hot-tubs/clarity-series/" class="chooser-card">
          <div class="chooser-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
          </div>
          <h3>Quiet wellness focus</h3>
          <p><strong>Clarity</strong> spas prioritize clean lines, intuitive controls, and a calmer soak. Built for thoughtful daily use without dominating your backyard.</p>
          <span class="chooser-cta">Explore Clarity <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/hot-tubs/lh-series/" class="chooser-card">
          <div class="chooser-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
          <h3>Therapy essentials at an accessible price</h3>
          <p>The <strong>LH Series</strong> focuses on what matters — purposeful hydrotherapy and dependable performance — without the premium upcharge.</p>
          <span class="chooser-cta">Explore LH <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/contact/" class="chooser-card">
          <div class="chooser-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/></svg>
          </div>
          <h3>Still unsure?</h3>
          <p>That's what the showroom is for. Tell us your space, your people, and how you'd use it — we'll walk you through two or three real options.</p>
          <span class="chooser-cta">Request a quote <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Showroom CTA -->
  <section class="visit-section">
    <div class="container">
      <div class="visit-grid">
        <div class="visit-content">
          <div class="section-eyebrow">Plan Your Visit</div>
          <h2>Sit in one before you decide.</h2>
          <p>Specs and photos only get you so far. Drop by the Bedford showroom and try a few in real water — it's how most of our customers make the call.</p>
          <div class="hero-ctas" style="margin-bottom: 0;">
            <a href="https://maps.google.com/?q=20+Duke+Street+Unit+109+Bedford+NS" class="btn btn-primary" rel="noopener">
              Get Directions
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/contact/" class="btn btn-outline">Request a Quote</a>
          </div>
        </div>
        <div class="visit-address">
          <div class="visit-address-line">
            <div class="visit-address-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></div>
            <div>
              <div class="visit-address-label">Showroom</div>
              <div class="visit-address-value">20 Duke Street, Unit 109<br />Bedford, NS B4A 2Z5</div>
            </div>
          </div>
          <div class="visit-address-line">
            <div class="visit-address-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></div>
            <div>
              <div class="visit-address-label">Phone</div>
              <div class="visit-address-value">902-576-5115</div>
            </div>
          </div>
          <div class="visit-address-line">
            <div class="visit-address-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
            <div>
              <div class="visit-address-label">Hours</div>
              <div class="visit-address-value">Mon–Sat · 10am–5pm<br />Sun · Closed</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
