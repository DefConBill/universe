---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { cities, regions } from '../../data/cities';

const siteOrigin = Astro.site?.origin ?? 'https://hottubuniverse.ca';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteOrigin}/` },
    { '@type': 'ListItem', position: 2, name: 'Areas We Serve', item: `${siteOrigin}/areas-we-serve/` },
  ],
};
---
<BaseLayout
  title="Areas We Serve — Nova Scotia, New Brunswick, PEI & Newfoundland | Hot Tub Universe"
  description="From our Bedford showroom, Hot Tub Universe delivers hot tubs and swim spas across Atlantic Canada — all of Nova Scotia, New Brunswick, PEI, and parts of Newfoundland. Full installation and service across HRM."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <Header />

  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="container">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page">Areas We Serve</li>
      </ol>
    </div>
  </nav>

  <!-- Hub hero -->
  <section class="hub-hero">
    <div class="container">
      <div class="hub-hero-inner">
        <div class="section-eyebrow">Where we deliver &amp; service</div>
        <h1>Serving Atlantic Canada, from our Bedford showroom.</h1>
        <p class="hub-hero-sub">
          We deliver hot tubs and swim spas across all of Nova Scotia, New Brunswick, Prince Edward Island, and parts of Newfoundland.
          Full installation and on-the-ground service is centred on Halifax Regional Municipality, with delivery and service
          to the wider region by arrangement. Wherever you are in the Maritimes, get in touch and we'll sort out the details.
        </p>
        <div class="hero-ctas" style="justify-content: center;">
          <a href="/contact/" class="btn btn-primary">
            Request a Quote
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/#visit" class="btn btn-outline">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Visit Bedford Showroom
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- HRM cities (full local pages) -->
  <section class="block cream">
    <div class="container">
      <div class="section-head">
        <div class="section-eyebrow">Our home region — Halifax &amp; HRM</div>
        <h2>Where we're on the road every day.</h2>
        <p>Across Halifax Regional Municipality we deliver, install, and service in person — usually same week. Pick your city for drive time from the showroom, delivery details, service response, and local FAQs.</p>
      </div>
      <div class="areas-grid">
        {cities.map((c) => (
          <a href={`/areas-we-serve/${c.slug}/`} class="area-card">
            <div class="area-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div class="area-card-content">
              <div class="area-name">{c.name}</div>
              <div class="area-meta">{c.driveTimeText}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Wider Atlantic Canada coverage -->
  <section class="block">
    <div class="container">
      <div class="section-head">
        <div class="section-eyebrow">Beyond HRM</div>
        <h2>Across the Maritimes &amp; Newfoundland.</h2>
        <p>We deliver to communities throughout the region. On-site service is arranged for areas outside HRM — tell us where you are and we'll confirm delivery and service options for your spot.</p>
      </div>
      <div class="region-grid">
        {regions.map((r) => (
          <div class="region-card">
            <div class="region-head">
              <h3>{r.province}</h3>
              <span class="region-tag">{r.provinceShort}</span>
            </div>
            <ul class="region-cities">
              {r.cities.map((city) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  <span>{city}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Don't see your area? -->
  <section class="block alt">
    <div class="container city-prose" style="text-align: center;">
      <div class="section-eyebrow">Don't see your area listed?</div>
      <h2>We very likely still deliver there.</h2>
      <p>The cities above are the ones our customers ask about most, but they're not the whole map. From the South Shore and the Valley to Cape Breton, across New Brunswick and PEI, and over to Newfoundland — if you're in Atlantic Canada, tell us where you live and we'll confirm delivery and service options and quote accordingly.</p>
      <div class="hero-ctas" style="justify-content: center; margin-top: 24px;">
        <a href="/contact/" class="btn btn-primary">
          Tell us where you live
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
