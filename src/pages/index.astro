---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import AreaCard from '../components/AreaCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';

const hotTubs = [
  {
    brand: 'Master Spas',
    name: 'Legend Series',
    description: 'The Michael Phelps signature collection. Premium hydrotherapy, deep ergonomic seating, and the most powerful jets we sell.',
    image: '/images/series-legend.jpg',
    imageAlt: 'Master Spas Legend Series hot tub',
    href: '/hot-tubs/legend-series/',
  },
  {
    brand: 'Master Spas',
    name: 'Twilight Series',
    description: 'Twilight Spas deliver a spa experience where relaxation meets refinement.',
    image: '/images/series-twilight.jpg',
    imageAlt: 'Master Spas Twilight Series hot tub',
    href: '/hot-tubs/twilight-series/',
  },
  {
    brand: 'Clarity',
    name: 'Clarity Series',
    description: 'Clarity Spas offer a way to enjoy rejuvenation, comfort and wellness on a whole different level.',
    image: '/images/series-clarity.jpg',
    imageAlt: 'Clarity Spas hot tub',
    href: '/hot-tubs/clarity-series/',
  },
  {
    brand: 'Master Spas',
    name: 'LH Series',
    description: 'With the LH Series, you can enjoy a spa experience that makes every day easier.',
    image: '/images/series-lh.jpg',
    imageAlt: 'Master Spas LH Series hot tub',
    href: '/hot-tubs/lh-series/',
  },
  {
    brand: 'Getaway',
    name: 'Getaway Hot Tubs',
    description: 'Five affordable models, plug-and-play friendly, perfect for first-time owners or smaller backyards.',
    image: '/images/series-getaway.jpg',
    imageAlt: 'Getaway hot tub on a lakeside deck at sunset',
    href: '/hot-tubs/getaway-hot-tubs/',
  },
];

const swimSpas = [
  {
    brand: 'Master Spas',
    name: 'Michael Phelps Signature',
    description: 'Designed with input from the 23-time Olympic gold medalist. Swim, train, and recover at any pace, any season.',
    image: '/images/series-michael-phelps.jpg',
    imageAlt: 'Master Spas Michael Phelps Signature swim spa',
    href: '/swim-spas/michael-phelps/',
  },
  {
    brand: 'Master Spas',
    name: 'H2X Swim Spas',
    description: 'Powerful jetted swim current paired with hydrotherapy seats. Built for serious swimmers who also want to unwind.',
    image: '/images/series-h2x.jpg',
    imageAlt: 'Master Spas H2X swim spa',
    href: '/swim-spas/h2x/',
  },
];

const testimonials = [
  {
    quote: '"The team didn\'t try to upsell us. They asked about our backyard, our family, and how we\'d actually use it — then walked us through three options. We\'ve had ours for two winters now and it\'s been bulletproof."',
    name: 'Sarah M.',
    meta: 'Bedford · Twilight Series owner',
    initials: 'SM',
  },
  {
    quote: '"Called on a Saturday morning when our pump failed. They had a tech here that afternoon, fixed it within an hour, and didn\'t oversell us on parts. Hard to find that kind of service anymore."',
    name: 'James K.',
    meta: 'Dartmouth · Service customer',
    initials: 'JK',
  },
  {
    quote: '"I trained for my marathon in our Michael Phelps swim spa through a Halifax winter. Bonkers good investment. The install crew were professional, on-time, and cleaned up after themselves."',
    name: 'Lauren P.',
    meta: 'Sackville · Michael Phelps swim spa owner',
    initials: 'LP',
  },
];

const areas = [
  { name: 'Bedford', meta: 'Our showroom is here', href: '/areas-we-serve/bedford-hot-tubs/' },
  { name: 'Halifax', meta: '15 min drive', href: '/areas-we-serve/halifax-hot-tubs/' },
  { name: 'Dartmouth', meta: '20 min drive', href: '/areas-we-serve/dartmouth-hot-tubs/' },
  { name: 'Sackville', meta: '10 min drive', href: '/areas-we-serve/sackville-hot-tubs/' },
  { name: 'Lower Sackville', meta: '12 min drive', href: '/areas-we-serve/lower-sackville-hot-tubs/' },
  { name: 'Cole Harbour', meta: '25 min drive', href: '/areas-we-serve/cole-harbour-hot-tubs/' },
  { name: 'Eastern Passage', meta: '28 min drive', href: '/areas-we-serve/eastern-passage-hot-tubs/' },
  { name: 'View all areas', meta: 'Hammonds Plains, Tantallon, Fall River…', href: '/areas-we-serve/' },
];
---
<BaseLayout>
  <Header />

  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <div>
        <div class="hero-eyebrow">Halifax · Bedford · Dartmouth · Sackville</div>
        <h1>Your peaceful escape, <span class="accent">delivered</span> across Halifax.</h1>
        <p class="hero-sub">Hot Tub Universe is HRM's locally owned, full-service hot tub and swim spa dealer. Forty-plus years of combined expertise and a real Bedford showroom you can visit. We help you choose the right tub — and stand behind it long after.</p>
        <div class="hero-ctas">
          <a href="#hot-tubs" class="btn btn-primary">
            Browse Hot Tubs
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="#visit" class="btn btn-outline">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Visit Our Showroom
          </a>
        </div>
        <div class="hero-trust">
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg> Master Spas Premier Dealer</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg> Locally Owned &amp; Operated</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg> Service Any Make &amp; Model</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust strip -->
  <div class="trust-strip">
    <div class="container trust-strip-inner">
      <div class="trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L4 5v6c0 5 3.5 9.5 8 11 4.5-1.5 8-6 8-11V5l-8-3z"/></svg>
        <div>
          <div class="trust-item-label">40+ Years</div>
          <div class="trust-item-text">Combined team experience</div>
        </div>
      </div>
      <div class="trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <div>
          <div class="trust-item-label">Bedford NS</div>
          <div class="trust-item-text">Real Halifax-area showroom</div>
        </div>
      </div>
      <div class="trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
        <div>
          <div class="trust-item-label">Master Spas</div>
          <div class="trust-item-text">Premier dealer · Twilight, Legend, Michael Phelps</div>
        </div>
      </div>
      <div class="trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        <div>
          <div class="trust-item-label">Full Service</div>
          <div class="trust-item-text">We repair any make or model</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Hot Tubs -->
  <section class="block" id="hot-tubs">
    <div class="container">
      <div class="section-head">
        <div class="section-eyebrow">Our Hot Tubs</div>
        <h2>Five series. One that's right for you.</h2>
        <p>From premium therapeutic spas to affordable family favourites, we carry the brands and configurations Atlantic Canadians actually use year-round.</p>
      </div>
      <div class="product-grid">
        {hotTubs.map((p) => <ProductCard {...p} />)}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="block testimonial-section">
    <div class="container">
      <div class="section-head">
        <div class="section-eyebrow">What Customers Say</div>
        <h2>People who actually own one.</h2>
        <p>Real reviews from real HRM customers. Placeholder text — to be replaced with reviews Bill selects.</p>
      </div>
      <div class="testimonial-grid">
        {testimonials.map((t) => <TestimonialCard {...t} />)}
      </div>
    </div>
  </section>

  <!-- Swim Spas -->
  <section class="block alt" id="swim-spas">
    <div class="container">
      <div class="section-head">
        <div class="section-eyebrow">Swim Spas</div>
        <h2>Swim, train, relax — all year round.</h2>
        <p>If your backyard can fit it, a swim spa gives you a pool, a hot tub, and a fitness machine in one. We carry the two brands worth owning in Atlantic Canada.</p>
      </div>
      <div class="product-grid cols-2" style="max-width: 880px; margin: 0 auto;">
        {swimSpas.map((p) => <ProductCard {...p} />)}
      </div>
    </div>
  </section>

  <!-- Why HTU -->
  <section class="block why-section">
    <div class="container">
      <div class="section-head">
        <div class="section-eyebrow">Why Hot Tub Universe</div>
        <h2>Built around how you actually buy a hot tub.</h2>
        <p>Buying a hot tub should feel like meeting a knowledgeable neighbour — not a pushy sales pitch. Here's what's different about working with us.</p>
      </div>
      <div class="why-grid">
        <div class="why-card">
          <div class="why-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>
          </div>
          <h3>Locally Owned &amp; Operated</h3>
          <p>We live here. Your hot tub is sold, delivered, and serviced by your neighbours — not a national chain. When you call us, you reach the people who own the place.</p>
        </div>
        <div class="why-card">
          <div class="why-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <h3>40+ Years Combined</h3>
          <p>Our team has installed, serviced, and lived with hot tubs across HRM for decades. We know what holds up to Atlantic winters.</p>
        </div>
        <div class="why-card">
          <div class="why-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <h3>Real Showroom, Real Tubs</h3>
          <p>Come see, sit in, and feel the difference at our Bedford showroom. Photos online can only tell you so much.</p>
        </div>
        <div class="why-card">
          <div class="why-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <h3>We Service Anything</h3>
          <p>Even if you didn't buy it from us. Our technicians repair every major brand.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service callout -->
  <section class="block" id="service">
    <div class="container">
      <div class="service-callout">
        <div>
          <div class="section-eyebrow" style="color: var(--sky);">Repairs &amp; Service</div>
          <h2>Your tub broke? We can probably fix it today.</h2>
          <p>Our technicians have years of training across every major hot tub and swim spa brand. We don't just sell — we keep tubs running for hundreds of HRM households, including plenty we never sold.</p>
          <div class="service-callout-actions">
            <a href="/service/" class="btn btn-primary">Book a Service Call</a>
            <a href="/water-care/" class="btn btn-outline">Watercare Help</a>
          </div>
        </div>
        <div class="service-callout-visual">
          <img src="/images/service-photo.jpg" alt="Hot Tub Universe service van — locally owned and operated, 902-576-5115" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Areas We Serve -->
  <section class="block cream" id="areas">
    <div class="container">
      <div class="section-head">
        <div class="section-eyebrow">Where We Deliver &amp; Service</div>
        <h2>Serving every corner of HRM.</h2>
        <p>From Bedford to Eastern Passage, we deliver, install, and service across Halifax Regional Municipality. Click your area for delivery details.</p>
      </div>
      <div class="areas-grid">
        {areas.map((a) => <AreaCard {...a} />)}
      </div>
    </div>
  </section>

  <!-- Visit showroom -->
  <section class="visit-section" id="visit">
    <div class="container">
      <div class="visit-grid">
        <div class="visit-content">
          <div class="section-eyebrow">Plan Your Visit</div>
          <h2>Come see them in person.</h2>
          <p>Photos and specs only get you so far. Drop by the Bedford showroom and sit in one — that's how most of our customers make the call.</p>
          <div class="visit-address">
            <div class="visit-address-line">
              <div class="visit-address-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></div>
              <div>
                <div class="visit-address-label">Showroom</div>
                <div class="visit-address-value">20 Duke Street, Unit 109<br />Bedford, NS B4A 2Z5</div>
              </div>
            </div>
            <div class="visit-address-line">
              <div class="visit-address-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></div>
              <div>
                <div class="visit-address-label">Phone</div>
                <div class="visit-address-value">902-576-5115</div>
              </div>
            </div>
            <div class="visit-address-line">
              <div class="visit-address-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
              <div>
                <div class="visit-address-label">Hours</div>
                <div class="visit-address-value">Mon–Sat · 10am–5pm<br />Sun · Closed</div>
              </div>
            </div>
          </div>
          <div class="hero-ctas" style="margin-bottom: 0;">
            <a href="https://maps.google.com/?q=20+Duke+Street+Unit+109+Bedford+NS" class="btn btn-primary" rel="noopener">
              Get Directions
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/contact/" class="btn btn-outline">Book a Showroom Visit</a>
          </div>
        </div>
        <div class="visit-map">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21 3 6"/><line x1="9" y1="3" x2="9" y2="18"/><line x1="15" y1="6" x2="15" y2="21"/></svg>
          <div>Embedded Google Map<br />(Bedford showroom)</div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
