---
// Site footer with NAP, navigation, and social
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo">
          <img src="/images/logo-white.png" alt="Hot Tub Universe" />
        </a>
        <p>Halifax's full-service hot tub and swim spa dealer. Master Spas, Getaway, and any tub you already own — we sell, install, and service across HRM, and deliver throughout Atlantic Canada.</p>
        <div class="footer-social">
          <a href="https://www.facebook.com/HotTubUniverse/" rel="noopener" target="_blank" aria-label="Hot Tub Universe on Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>
          <a href="https://www.instagram.com/hottubuniverse/" rel="noopener" target="_blank" aria-label="Hot Tub Universe on Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37zM17.5 6.5h0"/></svg></a>
          <a href="https://www.google.com/maps?cid=3407308325195967736" rel="noopener" target="_blank" aria-label="Hot Tub Universe reviews on Google"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.35 11.1H12v2.83h5.59a4.8 4.8 0 0 1-2.08 3.14v2.6h3.36c1.97-1.82 3.1-4.5 3.1-7.67 0-.65-.06-1.28-.17-1.9z"/><path d="M12 22c2.7 0 4.96-.9 6.62-2.43l-3.36-2.6c-.93.62-2.12.99-3.26.99-2.5 0-4.62-1.69-5.38-3.96H3.2v2.49C4.85 19.86 8.14 22 12 22z"/></svg></a>
        </div>
      </div>
      <div class="footer-col">
        <h4>Hot Tubs</h4>
        <ul>
          <li><a href="/hot-tubs/legend-series/">Legend Series</a></li>
          <li><a href="/hot-tubs/twilight-series/">Twilight Series</a></li>
          <li><a href="/hot-tubs/clarity-series/">Clarity Series</a></li>
          <li><a href="/hot-tubs/lh-series/">LH Series</a></li>
          <li><a href="/hot-tubs/getaway-hot-tubs/">Getaway Hot Tubs</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Swim Spas &amp; Service</h4>
        <ul>
          <li><a href="/swim-spas/michael-phelps/">Michael Phelps Signature</a></li>
          <li><a href="/swim-spas/h2x/">H2X Swim Spas</a></li>
          <li><a href="/service/">Repairs &amp; Service</a></li>
          <li><a href="https://hottubuniverse.myshopify.com/" rel="noopener">Watercare &amp; Accessories</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>About</h4>
        <ul>
          <li><a href="/about/">Our Story</a></li>
          <li><a href="/areas-we-serve/">Areas We Serve</a></li>
          <li><a href="/buying-guide/">Buying Guide</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <div>© {year} Hot Tub Universe. 20 Duke Street, Unit 109, Bedford NS B4A 2Z5. 902-576-5115.</div>
      <div>
        <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="/accessibility/">Accessibility</a>
