---
import type { Model } from '../data/series';

interface Props {
  model: Model;
  image: string;
  imageAlt: string;
  href?: string;       // if provided, the whole card becomes a link to that URL
}

const { model, image, imageAlt, href } = Astro.props;
const ctaLabel = href ? 'View details' : 'Request pricing';
const ctaHref = href ?? '/contact/';
const cardImage = model.image ?? image;
---
{href ? (
  <a href={href} class="model-card">
    <div class="model-card-image">
      <img src={cardImage} alt={imageAlt} loading="lazy" />
    </div>
    <div class="model-card-body">
      <h3>{model.name}</h3>
      {model.seating && (
        <div class="model-meta">
          {model.seating}{model.dimensions ? ` · ${model.dimensions}` : ''}
        </div>
      )}
      {model.description && <p>{model.description}</p>}
      <span class="model-card-link">
        {ctaLabel}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </span>
    </div>
  </a>
) : (
  <div class="model-card">
    <div class="model-card-image">
      <img src={cardImage} alt={imageAlt} loading="lazy" />
    </div>
    <div class="model-card-body">
      <h3>{model.name}</h3>
      {model.seating && (
        <div class="model-meta">
          {model.seating}{model.dimensions ? ` · ${model.dimensions}` : ''}
        </div>
      )}
      {model.description && <p>{model.description}</p>}
      <a href={ctaHref} class="model-card-link">
        {ctaLabel}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
)}
