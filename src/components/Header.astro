---
// Header: top contact bar + sticky main navigation
---
<div class="topbar">
  <div class="container">
    <div class="topbar-left">
      <a href="tel:9025765115">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        902-576-5115
      </a>
      <span>20 Duke Street, Unit 109, Bedford NS</span>
    </div>
    <div class="topbar-right">
      <span>Mon–Fri · 10am–5pm</span>
      <span>Sat · 10am–4pm</span>
    </div>
  </div>
</div>

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">
      <img src="/images/logo-white.png" alt="Hot Tub Universe — Full Service, Hot Tubs & Swim Spas" />
    </a>
    <nav class="main-nav">
      <a href="/hot-tubs/">Hot Tubs</a>
      <a href="/swim-spas/">Swim Spas</a>
      <a href="/buying-guide/">Buying Guide</a>
      <a href="/service/">Service</a>
      <a href="/areas-we-serve/">Areas We Serve</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
    </nav>
    <div class="header-actions">
      <a href="https://hottubuniverse.myshopify.com/" rel="noopener" target="_blank" class="header-cta">Visit Our Store</a>
      <a href="/contact/" class="header-cta">Request a Quote</a>
    </div>
    <button class="nav-toggle" id="navToggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNav">
      <svg class="nav-toggle-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      <svg class="nav-toggle-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <!-- Mobile nav panel -->
  <div class="mobile-nav" id="mobileNav" hidden>
    <nav class="mobile-nav-links" aria-label="Mobile">
      <a href="/hot-tubs/">Hot Tubs</a>
      <a href="/swim-spas/">Swim Spas</a>
      <a href="/buying-guide/">Buying Guide</a>
      <a href="/service/">Service</a>
      <a href="/areas-we-serve/">Areas We Serve</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
    </nav>
    <div class="mobile-nav-actions">
      <a href="https://hottubuniverse.myshopify.com/" rel="noopener" target="_blank" class="header-cta">Visit Our Store</a>
      <a href="/contact/" class="header-cta">Request a Quote</a>
    </div>
  </div>
</header>

<script>
  (function () {
    var toggle = document.getElementById('navToggle');
    var panel = document.getElementById('mobileNav');
    if (!toggle || !panel) return;

    function setOpen(open) {
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      toggle.classList.toggle('is-open', open);
      if (open) {
        panel.hidden = false;
        requestAnimationFrame(function () { panel.classList.add('is-open'); });
      } else {
        panel.classList.remove('is-open');
        window.setTimeout(function () { if (toggle.getAttribute('aria-expanded') === 'false') panel.hidden = true; }, 250);
      }
    }

    toggle.addEventListener('click', function () {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    panel.addEventListener('click', function (e) {
      if (e.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    window.addEventListener('resize', function () {
      if (window.innerWidth > 1024 && toggle.getAttribute('aria-expanded') === 'true') setOpen(false);
    });
  })();
</script>
